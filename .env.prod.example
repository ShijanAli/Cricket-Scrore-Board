# Your domain (an A record must point to this server). Free option: a DuckDNS subdomain.
DOMAIN=api.example.com
POSTGRES_PASSWORD=change-me-long-random
# Generate each with:  openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# "*" is fine for a mobile app (it does not use browser CORS). Use your site URL once you add a web viewer.
CORS_ORIGIN=*
