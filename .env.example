# apps/api
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://cricket:cricket@localhost:5432/cricket?schema=public
JWT_ACCESS_SECRET=change-me-access-min-32-chars-long-secret
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars-long-secret
CORS_ORIGIN=*
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# A scorer lock with no activity for this long can be taken over
SCORER_LOCK_TTL_SECONDS=120
