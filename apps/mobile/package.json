{
  "name": "@cricket/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "doctor": "expo-doctor",
    "eas-build-post-install": "pnpm --filter @cricket/shared build && pnpm --filter @cricket/engine build && pnpm --filter @cricket/client-core build",
    "build:apk": "eas build -p android --profile preview"
  },
  "dependencies": {
    "@cricket/client-core": "workspace:*",
    "@cricket/engine": "workspace:*",
    "@cricket/shared": "workspace:*",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^7.0.7",
    "@tanstack/react-query": "^5.107.2",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "socket.io-client": "^4.8.4",
    "zod": "^3.25.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^2.1.8"
  }
}
