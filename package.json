{
  "name": "cricket-app",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @cricket/api prisma:generate",
    "db:migrate": "pnpm --filter @cricket/api prisma:migrate",
    "db:deploy": "pnpm --filter @cricket/api prisma:deploy",
    "db:studio": "pnpm --filter @cricket/api prisma:studio",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,prisma}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  }
}
